{
  "expo": {
    "name": "Grovia",
    "slug": "grovia",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B21E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motiva.grovia"
    },
    "android": {
      "package": "com.motiva.grovia",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B21E8"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O Grovia usa a câmera para registrar fotos dos trechos inspecionados.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Grovia usa sua localização para vincular a inspeção ao trecho correto da rodovia."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6B21E8"
        }
      ],
      "expo-font"
    ]
  }
}
